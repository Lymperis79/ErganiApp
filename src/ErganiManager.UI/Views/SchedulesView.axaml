<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.SchedulesView"
             x:DataType="vm:SchedulesViewModel">

    <Grid>
        <!-- Main content -->
        <StackPanel Spacing="16">

            <Border IsVisible="{Binding !HasActiveCompany}" Background="#332D9CDB" CornerRadius="6" Padding="14">
                <TextBlock Text="{Binding NoCompanyMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel IsVisible="{Binding HasActiveCompany}" Spacing="16">

                <!-- Top bar: employee picker + month navigation -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Employee:" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableEmployees}"
                                  SelectedItem="{Binding SelectedEmployee}"
                                  Width="260">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{Binding Loc[ExportMonth]}" Command="{Binding ExportMonthCommand}" />
                        <Button Content="◀" Command="{Binding PreviousMonthCommand}" />
                        <TextBlock Text="{Binding MonthLabel}" FontSize="16" FontWeight="SemiBold"
                                   MinWidth="160" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="▶" Command="{Binding NextMonthCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Day-of-week header row -->
                <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="Mon" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="Tue" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="Gray" />
                    <TextBlock Grid.Column="2" Text="Wed" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="Gray" />
                    <TextBlock Grid.Column="3" Text="Thu" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="Gray" />
                    <TextBlock Grid.Column="4" Text="Fri" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="Gray" />
                    <TextBlock Grid.Column="5" Text="Sat" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#888888" />
                    <TextBlock Grid.Column="6" Text="Sun" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#888888" />
                </Grid>

                <!-- Calendar grid: 7-column uniform wrap, cells from ItemsControl -->
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarCellViewModel">
                            <Panel Width="120" Height="90" Margin="2">

                                <!-- Empty filler cell: not clickable -->
                                <Border IsVisible="{Binding !IsInMonth}" />

                                <!-- Day cell: Button styled as a tile -->
                                <Button IsVisible="{Binding IsInMonth}"
                                        Tag="{Binding}"
                                        Click="OnCellClick"
                                        Padding="8,6"
                                        Width="120" Height="90"
                                        VerticalContentAlignment="Top"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="8">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Background" Value="#1A1D23" />
                                    </Style>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#22252C" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding DayNumberText}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Name="DayNumber" />
                                        <TextBlock Grid.Column="1" Text="{Binding WorkTypeIcon}"
                                                   FontSize="14"
                                                   IsVisible="{Binding HasSchedule}" />
                                    </Grid>
                                    <TextBlock Text="{Binding TimeRangeText}" FontSize="11"
                                               Foreground="#AAAAAA"
                                               IsVisible="{Binding TimeRangeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <!-- Today indicator dot -->
                                    <Ellipse Width="6" Height="6" Fill="#2D9CDB"
                                             HorizontalAlignment="Left"
                                             IsVisible="{Binding IsToday}" />
                                </StackPanel>
                            </Button>

                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Legend -->
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                    <TextBlock Text="🏢 Office" Foreground="Gray" FontSize="12" />
                    <TextBlock Text="🏠 Home/Remote" Foreground="Gray" FontSize="12" />
                    <TextBlock Text="💤 Rest" Foreground="Gray" FontSize="12" />
                    <TextBlock Text="❌ Absent" Foreground="Gray" FontSize="12" />
                </StackPanel>

            </StackPanel>
        </StackPanel>

        <!-- Day-edit dialog overlay -->
        <Border IsVisible="{Binding IsDayDialogOpen}"
                Background="#AA000000">
            <Border Background="#1E2128" CornerRadius="12" Padding="28"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#3A3F4B" BorderThickness="1">
                <StackPanel Spacing="12">

                    <TextBlock Text="{Binding EditingDate, StringFormat='Schedule — {0:dddd, d MMMM yyyy}'}"
                               FontSize="17" FontWeight="Bold" />

                    <!-- Actual clock-in/out (read-only, from WorkCards) -->
                    <Border IsVisible="{Binding EditingActualText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#1A2D9CDB" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding EditingActualText}" FontSize="13" Foreground="#88CCEE" />
                    </Border>

                    <!-- Ergani submission status -->
                    <TextBlock Text="{Binding EditingSubmissionText}" FontSize="12" Foreground="#888888" />

                    <!-- Work type selector -->
                    <TextBlock Text="{Binding Loc[WorkType]}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding AvailableWorkTypes}"
                              SelectedItem="{Binding EditingWorkType}"
                              HorizontalAlignment="Stretch" />

                    <!-- Branch selector -->
                    <TextBlock Text="{Binding Loc[Branch]}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding AvailableBranches}"
                              SelectedItem="{Binding EditingBranch}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Time fields (only for Office/Home) -->
                    <Grid IsVisible="{Binding ShowTimeFields}" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Loc[StartTime]}" FontWeight="SemiBold" FontSize="12" />
                            <TimePicker SelectedTime="{Binding EditingStartTime}"
                                        ClockIdentifier="24HourClock" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Bottom"
                                   Margin="12,0" Padding="0,0,0,8" FontSize="16" />
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{Binding Loc[EndTime]}" FontWeight="SemiBold" FontSize="12" />
                            <TimePicker SelectedTime="{Binding EditingEndTime}"
                                        ClockIdentifier="24HourClock" />
                        </StackPanel>
                    </Grid>

                    <!-- Comments -->
                    <TextBlock Text="{Binding Loc[Comments]}" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditingComments}" AcceptsReturn="True" Height="60" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="Red"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Dialog buttons -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="Delete"
                                Command="{Binding DeleteDayCommand}"
                                IsVisible="{Binding IsEditingExisting}"
                                Foreground="#E57373" />
                        <Button Grid.Column="2" Content="Cancel"
                                Command="{Binding CloseDayDialogCommand}"
                                Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="Save"
                                Command="{Binding SaveDayCommand}"
                                Classes="accent" />
                    </Grid>

                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>
